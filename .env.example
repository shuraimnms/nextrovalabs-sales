# ── Required ──────────────────────────────────────────────
# Neon pooled connection string (use the "-pooler" host) with sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct (non-pooled) string, used only for running migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
APP_URL="https://sales.nextrovalabs.in"

# ── Optional ──────────────────────────────────────────────
SESSION_TTL_HOURS=12
# Max DB connections per instance. Defaults: 3 on Vercel, 10 elsewhere. Keep low with the Neon pooler.
# DB_POOL_MAX=3

# Password-reset email (Resend). If unset, admins issue reset links from Admin → Employees.
RESEND_API_KEY=
MAIL_FROM="Nextrova Sales OS <noreply@nextrovalabs.in>"

# Roleplay AI provider. Leave as "none" for the labelled rule-based simulator.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=

# Used ONLY by `npm run bootstrap:admin` (one-time). Pass at run time; never commit real values.
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_NAME=
# BOOTSTRAP_PASSWORD=

# ── E2E tests only (npm run test:e2e) ─────────────────────
# An existing Admin/Super Admin of a TEST database. Never point E2E at production.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
# PW_CHROMIUM_PATH=   # optional: use an already-installed Chromium
